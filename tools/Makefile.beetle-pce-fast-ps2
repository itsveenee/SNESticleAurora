# AURORA_PCE_EXPERIMENTAL_V1
# HuCard-first PS2 static build for beetle-pce-fast-libretro.
# Kept outside the submodule so the core source stays pristine.

DEBUG := 0
FRONTEND_SUPPORTS_RGB565 := 1
# AURORA_RUNTIME_LEAN_V1_PCE_BUILD_20260824
# Aurora has no PCE retro_cheat_* frontend path; do not advertise/compile the
# optional cheat configuration for the PS2 static core.
USE_CHEATS := 0
CORE_DIR := .
platform := ps2
CACHE_CD := 0
HAVE_HES := 0
NEED_BPP := 32
NEED_TREMOR := 0
NEED_BLIP := 1
NEED_CD := 1
NEED_CRC32 := 1
CORE_DEFINE := -DWANT_PCE_FAST_EMU
HAVE_CHD := 0
HAVE_CDROM := 0

# Makefile.common includes its libretro-common helper sources only when this
# is not 1. We still create a static archive ourselves below.
STATIC_LINKING := 0
TARGET := mednafen_pce_fast_libretro_ps2_raw.a

CC ?= mips64r5900el-ps2-elf-gcc
CXX ?= mips64r5900el-ps2-elf-g++
AR ?= mips64r5900el-ps2-elf-ar

# AURORA_MULTICORE_DEEP_PROFILER_V3_48_20261008
AURORA_FRONTEND_PROFILER ?= 0
AURORA_PROFILER_MODE_STAMP := .aurora-profiler-mode-$(AURORA_FRONTEND_PROFILER)

# AURORA_PCE_INCREMENTAL_BUILD_V1_20260824
# Keep a stable path to this external PS2 Makefile before Makefile.common
# extends MAKEFILE_LIST. Object files depend on both build descriptions, so
# flag/source-list changes invalidate only the Beetle objects that need it.
AURORA_PCE_PS2_MAKEFILE := $(abspath $(firstword $(MAKEFILE_LIST)))

include Makefile.common

WARNINGS := \
	-Wall \
	-Wno-sign-compare \
	-Wno-unused-variable \
	-Wno-unused-function \
	-Wno-uninitialized \
	-Wno-strict-aliasing \
	-Wno-unused-but-set-variable

AURORA_FRONTEND_PROFILER ?= 0

FLAGS += \
	-G0 -O3 -DNDEBUG -fomit-frame-pointer -ffast-math -fno-math-errno -finline-functions -funroll-loops \
	-fno-strict-aliasing -fwrapv -fsigned-char \
	-ffunction-sections -fdata-sections \
	-DPS2 -D_EE -DLSB_FIRST -DHAVE_UNISTD_H -DAURORA_PS2_PCE_FAST=1 -DAURORA_FRONTEND_PROFILER=$(AURORA_FRONTEND_PROFILER) \
	-DAURORA_FRONTEND_PROFILER=$(AURORA_FRONTEND_PROFILER) -I. \
	$(INCFLAGS) $(ENDIANNESS_DEFINES) $(WARNINGS) \
	-DMEDNAFEN_VERSION_NUMERIC=931 $(CORE_DEFINE) \
	-DSTDC_HEADERS -D__STDC_LIMIT_MACROS -D__LIBRETRO__ -D_LOW_ACCURACY_ \
	-DINLINE=inline

CFLAGS += $(FLAGS) -std=gnu99
CXXFLAGS += $(FLAGS) -std=gnu++11 -fno-exceptions -fno-rtti

# AURORA_PCE_MIPS_ASM_BUILD_V1_20260928
# This file is copied into the build-tree stage by Aurora's prepare tool.
SOURCES_S := $(CORE_EMU_DIR)/aurora_pce_hotpaths_ps2.S
SFLAGS := -G0 -O3 -DPS2 -D_EE -DAURORA_PS2_PCE_FAST=1
OBJECTS := $(SOURCES_CXX:.cpp=.o) $(SOURCES_C:.c=.o) $(SOURCES_S:.S=.o)

# AURORA_PCE_INCREMENTAL_BUILD_V1_20260824
# Header-aware incremental build. These flags only emit dependency metadata;
# they do not alter generated machine code.
DEPFLAGS := -MMD -MP
DEPS := $(OBJECTS:.o=.d)
-include $(DEPS)

# If the PS2 build recipe or upstream source list/defines change, let Make
# rebuild the affected core objects. No unconditional clean is necessary.
# Rebuild objects exactly once when switching normal <-> auroraprofile.
$(AURORA_PROFILER_MODE_STAMP):
	@rm -f .aurora-profiler-mode-0 .aurora-profiler-mode-1
	@touch $@

$(OBJECTS): $(AURORA_PCE_PS2_MAKEFILE) Makefile.common $(AURORA_PROFILER_MODE_STAMP)

.PHONY: all clean
all: $(TARGET)

$(TARGET): $(OBJECTS)
	@rm -f $@
	$(AR) rcs $@ $(OBJECTS)

%.o: %.cpp
	$(CXX) -c -o $@ $< $(CPPFLAGS) $(CXXFLAGS) $(DEPFLAGS)

%.o: %.c
	$(CC) -c -o $@ $< $(CPPFLAGS) $(CFLAGS) $(DEPFLAGS)

%.o: %.S
	$(CC) -c -o $@ $< $(CPPFLAGS) $(SFLAGS)

clean:
	rm -f $(OBJECTS) $(DEPS) $(TARGET) .aurora-profiler-mode-0 .aurora-profiler-mode-1
