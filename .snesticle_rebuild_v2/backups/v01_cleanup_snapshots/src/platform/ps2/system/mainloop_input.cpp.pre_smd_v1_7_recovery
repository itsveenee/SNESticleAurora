	if (!_bMenu && _pSystem == _pSnes &&
	    _pSnes->IsSuperWildCard() &&
	    !bSwcCreateHotkeyHeld &&
	    (buttons & PAD_L2) && (buttons & PAD_SQUARE) &&
	    !(buttons & PAD_R2) &&
	    (trigger & (PAD_L2 | PAD_SQUARE)))
	{
		bSwcCreateHotkeyHeld = TRUE;
		_MenuTriggerTimeout[0] = 0;
