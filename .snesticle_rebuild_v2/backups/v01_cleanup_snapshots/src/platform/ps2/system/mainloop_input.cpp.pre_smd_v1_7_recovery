			if (!_MainLoopStateConfirmPromptConsumeExecuted())
				MainLoopAudioUiResume();
		}
		return;
	}

	/* The one-time destination prompt is intentionally isolated from the
	   regular L1/R1 menu ring and from the L2+R2 SRAM shortcut. */
	if (_bMenu &&
