		Bool bLoadTrigger =
			(buttons & PAD_CIRCLE) &&
			(trigger & (PAD_L2 | PAD_CIRCLE));

		if (bSaveTrigger || bLoadTrigger)
		{
			bStateHotkeyHeld = TRUE;
