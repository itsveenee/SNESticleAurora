{
    FILE *fp; long nBytes,nBase; Uint8 v[2];
    const char *pName=_MainLoopSwcBaseName(pPath);
    if (!pPath || !*pPath || !pName || !_MainLoopMagicomPathIsFirmware(pPath) ||
