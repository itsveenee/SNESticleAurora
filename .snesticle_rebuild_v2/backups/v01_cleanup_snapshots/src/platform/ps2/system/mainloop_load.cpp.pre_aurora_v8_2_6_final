        S_ISDIR(st.st_mode))
        return FALSE;

    pExt = strrchr(pPath, '.');
    if (!pExt || strcasecmp(pExt, ".d88") != 0)
        return FALSE;

    n = (long)st.st_size;
    return _MainLoopSwcD88FileLooksValid(pPath, n);
}

